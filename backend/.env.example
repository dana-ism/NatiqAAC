# Placeholders only. Never copy development endpoints into test settings.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
DIRECT_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
REDIS_URL=redis://REPLACE_HOST:6379
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
PORT=3000
# Optional comma-separated exact web origins. No wildcard or trailing slash.
WEB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Public web origin used for verification links and fixed OAuth popup messages.
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173

# Sending is disabled until the owner authorizes the sender and a controlled test.
MAIL_ENABLED=false
MAIL_FROM=ydada1710@gmail.com
GMAIL_CLIENT_ID=REPLACE_WITH_SENDER_OAUTH_CLIENT_ID
GMAIL_CLIENT_SECRET=REPLACE_WITH_SENDER_OAUTH_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=REPLACE_WITH_AUTHORIZED_GMAIL_SEND_REFRESH_TOKEN

# Login client is separate from Gmail sending authorization. Backend secrets only.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/oauth/google/callback
FACEBOOK_APP_ID=REPLACE_WITH_META_APP_ID
FACEBOOK_APP_SECRET=REPLACE_WITH_META_APP_SECRET
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/oauth/facebook/callback
# Confirm a supported Graph version in the actual Meta app before enabling.
FACEBOOK_GRAPH_VERSION=REPLACE_WITH_SUPPORTED_GRAPH_VERSION

# Private bucket only. Service-role key must never be VITE_ configuration.
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_BACKEND_ONLY_STORAGE_KEY
SPECIALIST_DOCUMENT_BUCKET=specialist-qualifications
